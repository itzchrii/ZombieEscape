<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <title>Zombie Escape GPS</title>
  <!-- Leaflet CSS -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; user-select: none; }
    body, html { width: 100%; height: 100%; overflow: hidden; background: #0a0a0a; color: #fff; }
    #map { width: 100%; height: 100%; z-index: 1; }
    
    /* HUD OVERLAY */
    .hud { position: absolute; z-index: 10; pointer-events: none; width: 100%; height: 100%; display: flex; flex-direction: column; justify-content: space-between; padding: 15px; }
    .hud-top { display: flex; justify-content: space-between; align-items: flex-start; width: 100%; }
    
    /* NAV BOX - SPOSTATO IN ALTO PER NON COPRIRE IL GIOCATORE */
    .nav-box { background: rgba(15, 23, 42, 0.9); backdrop-filter: blur(8px); border: 1px solid #00E5FF; padding: 6px 14px; border-radius: 12px; text-align: center; color: #00E5FF; font-weight: bold; }
    .nav-arrow { font-size: 18px; display: inline-block; transition: transform 0.2s; }
    .stats-box { background: rgba(0,0,0,0.8); padding: 8px 12px; border-radius: 10px; font-size: 14px; border: 1px solid #333; }
    .lives { color: #ff4757; font-size: 18px; }

    .hud-bottom { display: flex; justify-content: space-between; align-items: flex-end; width: 100%; pointer-events: auto; }
    .metric-card { background: rgba(15, 23, 42, 0.9); border: 1px solid #333; padding: 10px 14px; border-radius: 10px; min-width: 95px; text-align: center; }
    .metric-value { font-size: 18px; font-weight: bold; color: #00FF66; }
    .metric-label { font-size: 10px; color: #888; text-transform: uppercase; }

    /* CONTROLLI SIMULATORE / JOYSTICK PER PROVE SUL DIVANO */
    .dev-controls { position: absolute; bottom: 85px; left: 50%; transform: translateX(-50%); z-index: 20; display: flex; gap: 8px; background: rgba(0,0,0,0.8); padding: 8px; border-radius: 12px; pointer-events: auto; }
    .dev-btn { background: #222; color: #fff; border: 1px solid #555; width: 42px; height: 42px; border-radius: 8px; font-weight: bold; font-size: 18px; cursor: pointer; }
    .dev-btn:active { background: #00FF66; color: #000; }

    /* HOME SCREEN & MANUAL MODAL */
    .modal { position: fixed; inset: 0; background: rgba(10, 10, 10, 0.96); z-index: 100; display: flex; flex-direction: column; padding: 25px; overflow-y: auto; }
    .btn-main { background: #00FF66; color: #000; font-weight: bold; font-size: 18px; padding: 16px; border: none; border-radius: 12px; width: 100%; margin-top: 15px; cursor: pointer; }
    .btn-main:active { opacity: 0.8; }
    .manual-card { background: #151515; border: 1px solid #262626; padding: 12px; border-radius: 8px; margin-bottom: 10px; }
    .manual-card h4 { color: #00E5FF; margin-bottom: 4px; }
    .manual-card p { font-size: 13px; color: #ccc; line-height: 1.4; }
  </style>
</head>
<body>

  <!-- HOME SCREEN & MANUAL -->
  <div id="home-screen" class="modal">
    <h1 style="color:#00FF66; text-align:center; margin-bottom: 5px;">ZOMBIE ESCAPE GPS</h1>
    <p style="text-align:center; color:#888; font-size:14px; margin-bottom: 20px;">Real-World GPS Survival Runner</p>
    
    <div class="manual-card">
      <h4>Chapter 1: Physical Movement</h4>
      <p>No virtual sprint buttons! Run in the real world to move your survivor on the map and evade zombie hordes.</p>
    </div>
    <div class="manual-card">
      <h4>Chapter 2: Threats & Lives</h4>
      <p>Walkers (Red) and Runners (Orange) track your real position. Keep a safe distance or lose health points.</p>
    </div>
    <div class="manual-card">
      <h4>Chapter 3: Extractions & Supply Crates</h4>
      <p>Reach the marked Extraction Zone before the timer reaches 00:00. Collect Yellow crates for medical supplies and decoys.</p>
    </div>
    <div class="manual-card">
      <h4>Chapter 4: Proximity Heartbeat</h4>
      <p>Wear headphones. The heartbeat audio frequency increases as zombies close in on your location.</p>
    </div>
    <div class="manual-card">
      <h4>Chapter 5: Safety First</h4>
      <p>Always stay aware of real-world obstacles and traffic. Anti-cheat kicks in if speeds exceed 25 km/h.</p>
    </div>

    <button class="btn-main" onclick="startGame()">START RUN</button>
  </div>

  <!-- HUD INTERFACE -->
  <div class="hud">
    <div class="hud-top">
      <div class="stats-box">
        <div class="lives">♥♥♥</div>
        <div id="wave-txt" style="font-size:11px; color:#aaa;">WAVE 1</div>
      </div>
      
      <!-- NAVIGATION BOX IN ALTO AL CENTRO -->
      <div class="nav-box">
        <div id="nav-arrow" class="nav-arrow">⬆</div>
        <div id="nav-dist">0m</div>
      </div>

      <div class="stats-box" style="text-align:right;">
        <div id="timer" style="color:#00FF66; font-weight:bold; font-size:16px;">03:00</div>
        <div id="score" style="font-size:11px; color:#aaa;">PTS: 0</div>
      </div>
    </div>

    <!-- CONTROLLI SIMULATORE / DIVANO -->
    <div class="dev-controls" id="dev-panel">
      <button class="dev-btn" onclick="moveSim(0.0001, 0)">▲</button>
      <button class="dev-btn" onclick="moveSim(0, -0.0001)">◄</button>
      <button class="dev-btn" onclick="moveSim(-0.0001, 0)">▼</button>
      <button class="dev-btn" onclick="moveSim(0, 0.0001)">►</button>
    </div>

    <div class="hud-bottom">
      <div class="metric-card">
        <div id="threat-dist" class="metric-value" style="color:#ff4757;">--</div>
        <div class="metric-label">Threat</div>
      </div>
      <div class="metric-card">
        <div id="speed" class="metric-value">0.0</div>
        <div class="metric-label">km/h</div>
      </div>
    </div>
  </div>

  <!-- CONTAINER MAPPA -->
  <div id="map"></div>

  <!-- Leaflet JS -->
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script>
    let map, playerMarker;
    let playerPos = [45.4642, 9.1900]; // Coordinate iniziali di test

    function initMap() {
      map = L.map('map', { zoomControl: false }).setView(playerPos, 17);
      
      L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
        maxZoom: 19
      }).addTo(map);

      // Marker Giocatore (Punto verde senza niente sopra)
      const playerIcon = L.divIcon({
        className: 'player-icon',
        html: '<div style="width:18px; height:18px; background:#00FF66; border:2px solid #fff; border-radius:50%; box-shadow: 0 0 12px #00FF66;"></div>',
        iconSize: [18, 18]
      });
      playerMarker = L.marker(playerPos, { icon: playerIcon }).addTo(map);
    }

    function startGame() {
      document.getElementById('home-screen').style.display = 'none';
      
      // Tentativo attivazione GPS reale
      if (navigator.geolocation) {
        navigator.geolocation.watchPosition(
          (pos) => {
            playerPos = [pos.coords.latitude, pos.coords.longitude];
            updatePlayerLocation();
            // Nasconde le frecce del simulatore se rileva il GPS reale
            document.getElementById('dev-panel').style.display = 'none';
          },
          (err) => {
            console.log("GPS unavailable. Using manual controls.");
          },
          { enableHighAccuracy: true }
        );
      }
    }

    function updatePlayerLocation() {
      playerMarker.setLatLng(playerPos);
      map.panTo(playerPos);
    }

    // Movimento con le frecce touch per i test da fermo
    function moveSim(latOffset, lngOffset) {
      playerPos[0] += latOffset;
      playerPos[1] += lngOffset;
      updatePlayerLocation();
    }

    window.onload = initMap;
  </script>
</body>
</html>